#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

ynh_print_info "Declaring files to be backed up..."

#=================================================
# BACKUP THE GENEALOGY DATA
#=================================================

# install_dir is intentionally NOT backed up: it is reproducible from the
# pinned release asset. The genealogy bases are what actually matter.
ynh_backup "$data_dir"

#=================================================
# BACKUP SYSTEM CONFIGURATION
#=================================================

ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"

ynh_backup "/etc/systemd/system/$app.service"
ynh_backup "/etc/systemd/system/$app-gwsetup.service"

ynh_backup "/etc/logrotate.d/$app"

# NB: no trailing slash: the ynh restore machinery exact-matches /var/log/$app
ynh_backup "/var/log/$app"

#=================================================
# END OF SCRIPT
#=================================================

ynh_print_info "Backup script completed for $app. (YunoHost will then actually copy those files to the archive)."
